{
  "name": "@assistant-ui/inject",
  "version": "0.0.0",
  "description": "A minimal dependency injection library: generators that yield* the services they need",
  "license": "MIT",
  "author": "AgentbaseAI Inc.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@11.9.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "aui-build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\""
  },
  "devDependencies": {
    "@assistant-ui/x-buildutils": "^0.0.16",
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3"
  }
}
